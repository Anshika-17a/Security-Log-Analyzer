# ─── Copy this file to .env and fill in your values ──────────────────────────
#     cp .env.example .env
# .env is gitignored — never commit real keys.

# Where to store data.
#   SQLite (default, local dev):
DATABASE_URL=sqlite:///./logs.db
#   Postgres (any provider — Render/Neon/Supabase/Railway). The app rewrites
#   postgres:// and postgresql:// to the psycopg v3 driver automatically:
# DATABASE_URL=postgresql://user:password@host:5432/security_logs

# Google Gemini API key. Enables the "Generate narrative" button in the
# incident modal (GET /api/incidents/{id}/narrative), which clusters the
# incident's logs with Drain3 and asks Gemini for an executive summary.
# Get one free at https://aistudio.google.com/apikey
# Leave blank to disable — the endpoint returns a friendly message instead.
GEMINI_API_KEY=

# Populate an empty database with data/sample_logs.csv on startup and run the
# full pipeline. Useful on hosted free tiers so the dashboard is never empty.
# No-ops if the database already has logs.
SEED_ON_START=false
SEED_FILE=data/sample_logs.csv
